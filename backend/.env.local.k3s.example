# =============================================================================
# Nexus AI Engine — K3s local dev (host-run backend + port-forwarded services)
# =============================================================================
# Copy to .env.local before starting the reference server:
#   cp .env.local.k3s.example .env.local
#
# Prerequisites:
#   nexus-deployer/local-k3s: deploy-local-aws-stack.sh
#   make port-forward-k3s
#   make init-k3s-local-aws
# =============================================================================

# --- Mode switch ---
USE_LOCALSTACK=true
LOCALSTACK_HOST=127.0.0.1
LOCALSTACK_PORT=4566
ENVIRONMENT=local
CAPABILITY_NAME=ai-engine
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Split endpoints (K3s hybrid — Scylla DDB on :8001, API on :8000)
AWS_ENDPOINT_URL_DYNAMODB=http://127.0.0.1:8001
AWS_ENDPOINT_URL_S3=http://127.0.0.1:9000
AWS_ENDPOINT_URL_GLUE=http://127.0.0.1:4566
AWS_ENDPOINT_URL_SSM=http://127.0.0.1:4566
AWS_ENDPOINT_URL_SECRETSMANAGER=http://127.0.0.1:4566
AWS_DISABLE_EXPLICIT_SERVICE_ENDPOINTS=false

# Same bootstrap contract as in-cluster / remote EKS deployments
SSM_PARAMETER_PREFIX=/ai-engine/local/
SECRETS_PREFIX=ai-engine/local/

SCYLLA_ENDPOINT=http://127.0.0.1:8001
MINIO_ENDPOINT=http://127.0.0.1:9000
MINISTACK_ENDPOINT=http://127.0.0.1:4566

# --- Capability + environment (table/bucket names derive from these) ---
# DynamoDB: {CAPABILITY_NAME}-{ENVIRONMENT}-{purpose}
#   e.g. ai-engine-local-journeys  (local K3s)
# S3 buckets: {capability}-{environment}-{purpose}[-{account_id}]
LOCAL_AWS_ACCOUNT_ID=000000000000

# Optional explicit overrides (defaults derived from CAPABILITY_NAME + ENVIRONMENT):
# DYNAMODB_TRANSFORMATION_TABLE=ai-engine-local-journeys
# DYNAMODB_EXECUTIONS_TABLE=ai-engine-local-executions
# DYNAMODB_PROMPTS_TABLE=ai-engine-local-prompts
# S3_JOURNEY_LOGS_BUCKET=ai-engine-local-journey-logs
# S3_JOURNEY_REPORTS_BUCKET=ai-engine-local-journey-reports

API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
REGISTER_DEMO_STAGES=true
# Auto-seed 5 demo journeys on startup when ENVIRONMENT=local and DynamoDB is empty
SEED_DEMO_JOURNEYS=true

# Do not use AWS_PROFILE here — K3s set-context may export AWS_PROFILE=local for kubectl only.
# Host-run backend uses minioadmin keys above; unset profile in your shell if needed:
#   unset AWS_PROFILE
