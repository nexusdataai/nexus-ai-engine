    "caller_execution_id": {
      "format": "uuid",
      "title": "Caller Execution Id",
      "type": "string"
    },
    "caller_node_id": {
      "format": "uuid",
      "title": "Caller Node Id",
      "type": "string"
    },
    "caller_planner_result_id": {
      "format": "uuid",
      "title": "Caller Planner Result Id",
      "type": "string"
    },
    "capability": {
      "title": "Capability",
      "type": "string"
