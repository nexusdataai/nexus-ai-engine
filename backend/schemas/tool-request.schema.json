    "version",
    "created_at",
    "tenant_id",
    "trace_id",
    "tool_id",
    "tool_version",
    "capability",
    "mode",
    "idempotency_key",
    "caller_execution_id",
    "caller_node_id",
    "caller_planner_result_id"
