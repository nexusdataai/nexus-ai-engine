# Nexus AI Engine UI — K3s local dev (Vite proxy to host backend on :8000)
#
# Copy to .env.local:
#   cp .env.local.k3s.example .env.local
#
# Leave VITE_API_BASE_URL empty so the browser uses same-origin requests
# proxied by Vite to http://127.0.0.1:8000.

VITE_API_BASE_URL=

# Optional dev auth token (if backend auth is enabled)
# VITE_DEV_TOKEN=dev-token
